<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <!-- 가상 내비 링크(디버그 전용): PC 중계 서버와 평문 웹소켓. release 병합 매니페스트에는 포함되지 않습니다. -->
 <uses-permission android:name="android.permission.INTERNET"/>
 <application android:usesCleartextTraffic="true">
  <!-- 디버그 전용 차량 신호 흉내(adb shell am broadcast). release 빌드에는 포함되지 않습니다. -->
  <receiver android:name=".debug.DebugSignalReceiver" android:exported="true">
   <intent-filter><action android:name="com.goodnight.souprules.DEBUG"/></intent-filter>
  </receiver>
  <!-- 프로세스가 뜰 때 DebugLink를 자동 시작 -->
  <provider android:name=".debug.DebugLinkProvider" android:authorities="${applicationId}.debuglink"
   android:exported="false"/>
 </application>
</manifest>
